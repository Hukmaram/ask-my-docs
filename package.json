    "fast-xml-parser": "^5.11.1",
    "helmet": "^8.1.0",
    "js-tiktoken": "^1.0.21",
    "morgan": "^1.10.0",
    "pdfjs-dist": "^6.2.108",
    "yaml": "^2.9.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.13.3",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0"
