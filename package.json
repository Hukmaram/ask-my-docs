{
  "name": "ask-my-docs",
  "version": "1.0.0",
  "private": true,
  "description": "A citation-grounded domain-specific RAG system",
  "main": "dist/main.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "ingest": "tsx scripts/ingest.ts",
    "eval": "tsx scripts/evaluation-runner.ts",
    "eval:json": "tsx scripts/evaluation-runner.ts --json dist/evaluation-summary.json",
    "eval:ci": "tsx scripts/evaluation-runner.ts --json dist/evaluation-summary.json --ci"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans": "^5.3.0",
    "@huggingface/transformers": "^4.2.0",
    "@langfuse/otel": "^5.11.1",
    "@langfuse/tracing": "^5.11.1",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@opentelemetry/sdk-node": "^0.222.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "fast-xml-parser": "^5.11.1",
    "helmet": "^8.1.0",
    "js-tiktoken": "^1.0.21",
    "morgan": "^1.10.0",
    "pdfjs-dist": "^6.2.108",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "yaml": "^2.9.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0"
  }
}
